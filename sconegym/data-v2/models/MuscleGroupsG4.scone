# torso muscle groups
MuscleGroup {
	name = obl_ant_r
	include = "int_obl1_r;int_obl2_r;ext_obl1_l;ext_obl2_l"
}
MuscleGroup {
	name = int_obl_r
	include = "int_obl3_r;int_obl4_r"
}
MuscleGroup {
	name = ext_obl_r
	include = "ext_obl3_r;ext_obl4_r"
}

# shoulder-arm muscle groups
